# Template — copy to ``secret-email.yaml`` and substitute the real
# DreamHost mailbox password, then ``kubectl apply -f`` it directly.
# DO NOT commit the populated copy; ``.gitignore`` excludes
# ``base/secret-email.yaml``.
#
# Rotation: the ``dheeraj@dheerajchand.com`` mailbox is shared with the
# resume-generator product. Rotating the password requires updating
# this Secret AND ``resume-generator-email`` (in the
# ``resume-generator`` namespace), then rolling-restart BOTH
# Deployments. Track rotations in the deploy log.
#
# Per epic ellington-web#96 sub-ticket (l) / #101.
apiVersion: v1
kind: Secret
metadata:
  name: ellington-web-email
  namespace: ellington
type: Opaque
stringData:
  EMAIL_HOST_PASSWORD: "REPLACE_WITH_DREAMHOST_MAILBOX_PASSWORD"
