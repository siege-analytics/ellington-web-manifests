# Operator-applied — NOT a manifest ArgoCD reconciles.
#
# Documents the Secret shape that base/job-ensure-superuser.yaml
# consumes via envFrom. Apply once with the live credentials chosen by
# the operator:
#
#   kubectl -n ellington create secret generic ellington-web-admin \
#     --from-literal=ADMIN_USERNAME='dheeraj' \
#     --from-literal=ADMIN_EMAIL='dheeraj@elect.info' \
#     --from-literal=ADMIN_PASSWORD='<paste from password manager>'
#
# After application, the Job manifest can be applied (or ArgoCD will
# apply it from base/), and `manage.py ensure_superuser` reads the
# values from os.environ. Idempotent: re-apply does NOT reset the
# password if the user already exists. Password rotation goes through
# `manage.py changepassword` (see README §6 rotation recipe).
#
# This file is committed as documentation of the secret's shape only.
# Do NOT add a real password here.

apiVersion: v1
kind: Secret
metadata:
  name: ellington-web-admin
  namespace: ellington
type: Opaque
stringData:
  ADMIN_USERNAME: "PLACEHOLDER"
  ADMIN_EMAIL: "PLACEHOLDER@example.com"
  ADMIN_PASSWORD: "PLACEHOLDER — see kubectl recipe above"
