# Operator-applied — NOT a manifest ArgoCD reconciles.
#
# Apply once during bootstrap with the live password generated when the
# `ellington_web` DB + role were created on the `default/db-postgis-master`
# postgres instance (see README § sub-2c bootstrap).
#
#   kubectl -n ellington create secret generic ellington-web-postgres \
#     --from-literal=SQL_PASSWORD='<paste from the operator console>'
#
# After application, the Deployment's envFrom block injects SQL_PASSWORD
# alongside the ellington-web-config ConfigMap values, and Django reads
# it via os.environ["SQL_PASSWORD"] in settings/django_settings.py.
#
# This file is committed as documentation of the secret's shape only.
# Do NOT add a real password here; the cluster Secret is the source of
# truth and is never serialised into git.

apiVersion: v1
kind: Secret
metadata:
  name: ellington-web-postgres
  namespace: ellington
type: Opaque
stringData:
  SQL_PASSWORD: "PLACEHOLDER — see kubectl recipe above"
